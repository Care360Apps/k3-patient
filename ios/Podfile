# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # Several pods (google_maps_flutter_ios, razorpay-core-pod) exclude arm64
      # from simulator builds via xcconfig. On Apple Silicon Macs the simulator
      # IS arm64, so this exclusion cascades into Pods-Runner and prevents the
      # entire umbrella framework from building. Override with empty string in
      # build settings (which takes precedence over xcconfig values).
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = ''
    end

    if target.name == 'google_maps_flutter_ios'
      target.build_configurations.each do |config|
        config.build_settings['MODULEMAP_FILE'] = '$(PODS_ROOT)/../.symlinks/plugins/google_maps_flutter_ios/ios/Classes/google_maps_flutter_ios.modulemap'
      end
    end
  end

  # Ad-hoc sign all unsigned XCFramework simulator slices.
  # Agora SDK 4.2.6, AgoraIrisRTC, and GoogleMaps ship their simulator
  # frameworks without code signatures. Xcode 16+ / iOS 26 simulators
  # reject unsigned dynamic frameworks at launch (DYLD "Library missing").
  Dir.glob("#{installer.sandbox.root}/**/*.xcframework/ios-*simulator*/*.framework").each do |fw|
    signed = `codesign -vv "#{fw}" 2>&1`
    if signed.include?("not signed")
      system("codesign --force --sign - --timestamp=none \"#{fw}\"")
    end
  end
end

target 'OneSignalNotificationServiceExtension' do
  use_frameworks!
  pod 'OneSignalXCFramework', '5.4.1'
end
